# YNAB CLI Environment Variables
# Copy this file to .env and fill in your values
# Note: Using 'ynab login' is the recommended way to configure credentials

# YNAB API Token (get from https://app.ynab.com/settings/developer)
YNAB_API_TOKEN=your_token_here

# Budget ID ('last-used', 'default', or a specific budget UUID)
YNAB_BUDGET_ID=last-used
