{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-python-quality.sh",
            "statusMessage": "Running code quality checks...",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-quality.sh",
            "statusMessage": "Verifying code quality before finishing...",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
